PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/codemaster
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional: configure a private/protected Judge0 service for code execution.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_LANGUAGE_ID_C=103
JUDGE0_LANGUAGE_ID_CPP=105
JUDGE0_LANGUAGE_ID_JAVA=91
JUDGE0_LANGUAGE_ID_JAVASCRIPT=102

# Optional: OpenAI-compatible learning assistant provider.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional: Google and GitHub OAuth. Configure production callbacks on the provider apps.
API_PUBLIC_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
